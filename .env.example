# Whisper Transcription App Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#

# HuggingFace Token (required for speaker diarization)
# Get your token at: https://huggingface.co/settings/tokens
# Accept model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Whisper Model Size (optional, default: large-v3)
# Options: tiny, base, small, medium, large-v3
# Smaller models are faster but less accurate
WHISPER_MODEL_SIZE=large-v3

# Backend URL (for NAS frontend deployment)
# Set this to your backend server's IP address or hostname
BACKEND_URL=http://localhost:8000

# Mistral API Key (optional - for Voxtral cloud transcription)
# Get your key at: https://console.mistral.ai/api-keys
# Pricing: $0.003/minute for Voxtral Mini Transcribe V2
# MISTRAL_API_KEY=your_mistral_api_key_here
