# Davrine Transcription App Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#

# HuggingFace Token (required for speaker diarization rate limits)
# A read-only token suffices: https://huggingface.co/settings/tokens
# Model: https://huggingface.co/pyannote/speaker-diarization-community-1
# (open-source, no terms acceptance required — unlike the older 3.1 model)
HF_TOKEN=your_huggingface_token_here

# Whisper Model Size (optional, default: large-v3-turbo)
# Options: tiny, base, small, medium, large-v3, large-v3-turbo, distil-large-v3
# large-v3-turbo is ~2x faster than large-v3 on MLX with <0.5% WER delta (809M vs 1.5B params)
WHISPER_MODEL_SIZE=large-v3-turbo

# Backend URL (for NAS frontend deployment)
# Set this to your backend server's IP address or hostname
BACKEND_URL=http://localhost:8000

# Mistral API Key (optional - for Voxtral cloud transcription)
# Get your key at: https://console.mistral.ai/api-keys
# Pricing: $0.003/minute for Voxtral Mini Transcribe V2
# MISTRAL_API_KEY=your_mistral_api_key_here
