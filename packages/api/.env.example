# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/v42_prefills
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json  # or 'text' for development
LOG_FILE=/var/log/v42-api/app.log
EVENT_LOG_FILE=/var/log/v42-api/events.log

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourapp.com
CORS_ALLOW_CREDENTIALS=true

# Authentication (if applicable)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Monitoring & Observability (for future integration)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Grafana Cloud / Prometheus (for future integration)
GRAFANA_CLOUD_API_KEY=
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Performance
REQUEST_TIMEOUT_SECONDS=30
SLOW_QUERY_THRESHOLD_MS=1000

# Feature Flags
ENABLE_DETAILED_LOGGING=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_EVENT_TRACKING=true
