<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisper.frontend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/node@18/bin/npx</string>
        <string>serve</string>
        <string>-s</string>
        <string>build</string>
        <string>-l</string>
        <string>3000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidmarchesseau/Development/whisper-transcription-app</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@18/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/davidmarchesseau</string>
    </dict>

    <!-- Start automatically on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Always restart -->
    <key>KeepAlive</key>
    <true/>

    <!-- Prevent rapid restart loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>/Users/davidmarchesseau/.whisper-frontend.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidmarchesseau/.whisper-frontend.error.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
