<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisper.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/davidmarchesseau/Development/apps/whisper-transcription-app/backend/venv/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidmarchesseau/Development/apps/whisper-transcription-app/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_TOKEN</key>
        <string>YOUR_HF_TOKEN_HERE</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>/Users/davidmarchesseau/Development/apps/whisper-transcription-app/backend/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Start automatically on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Always restart -->
    <key>KeepAlive</key>
    <true/>

    <!-- Prevent rapid restart loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>/Users/davidmarchesseau/.whisper-backend.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidmarchesseau/.whisper-backend.error.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
