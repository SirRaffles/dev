<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisper.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec /Users/davidmarchesseau/Development/apps/whisper-transcription-app/scripts/start-backend.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidmarchesseau/Development/apps/whisper-transcription-app/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>/Users/davidmarchesseau/Development/apps/whisper-transcription-app/backend/venv/bin:/Users/davidmarchesseau/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>UVICORN_HOST</key>
        <string>0.0.0.0</string>
    </dict>

    <!-- Start automatically on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Always restart -->
    <key>KeepAlive</key>
    <true/>

    <!-- Prevent rapid restart loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>/Users/davidmarchesseau/Library/Logs/whisper/backend.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidmarchesseau/Library/Logs/whisper/backend.error.log</string>

    <!-- Adaptive: latency-sensitive workload. Under "Background", macOS
         aggressively throttles the process when the lid is closed or the
         display sleeps — observed 20× slowdown on long transcriptions
         (6h idle window for ~18 chunks). Adaptive keeps normal scheduling
         priority even while the system is idle. -->
    <key>ProcessType</key>
    <string>Adaptive</string>

    <!-- Opt out of timer coalescing so our chunk-loop sleeps aren't batched
         into long hibernation windows. -->
    <key>LegacyTimers</key>
    <true/>
</dict>
</plist>
